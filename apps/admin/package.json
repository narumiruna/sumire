{
  "name": "@narumitw/sumire-admin",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 17466 --strictPort",
    "build": "tsc --noEmit && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build:dependencies": "npm run build --workspace @narumitw/sumire-issues && npm run build --workspace @narumitw/sumire-policy && npm --ignore-scripts run build --workspace @narumitw/sumire-contracts",
    "predev": "npm run build:dependencies",
    "prebuild": "npm run build:dependencies",
    "pretest": "npm run build:dependencies",
    "pretypecheck": "npm run build:dependencies",
    "pretest:browser": "npm run build:dependencies"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@narumitw/sumire-contracts": "0.11.0",
    "@narumitw/sumire-issues": "0.2.0",
    "@narumitw/sumire-policy": "0.5.3",
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@radix-ui/themes": "3.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "html-to-image": "1.11.13",
    "i18next": "27.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2"
  }
}
