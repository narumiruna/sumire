{
  "name": "@narumitw/sumire",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dependencies": "npm run build --workspace @narumitw/sumire-url-tool && npm run build --workspace @narumitw/sumire-progress && npm run build --workspace @narumitw/sumire-login",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prebuild": "npm run build:dependencies",
    "predev": "npm run build:dependencies",
    "prestart": "npm run build:dependencies",
    "pretest": "npm run build:dependencies",
    "pretest:watch": "npm run build:dependencies",
    "pretypecheck": "npm run build:dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@firecrawl/anydoc": "0.2.4",
    "@grammyjs/runner": "2.0.3",
    "@narumitw/otter-cli": "0.3.1",
    "@narumitw/sumire-login": "0.1.1",
    "@narumitw/sumire-progress": "0.1.3",
    "@narumitw/sumire-url-content": "0.22.3",
    "@narumitw/sumire-url-tool": "0.3.3",
    "@pydantic/logfire-node": "0.18.27",
    "grammy": "1.46.0",
    "taiwan-exchange-rates": "0.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
