{
  "name": "@narumitw/sumire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dependencies": "npm run build --workspace @narumitw/sumire-url-content && npm run build --workspace @narumitw/sumire-progress",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prebuild": "npm run build:dependencies",
    "predev": "npm run build:dependencies",
    "prestart": "npm run build:dependencies",
    "pretest": "npm run build:dependencies",
    "pretest:watch": "npm run build:dependencies",
    "pretypecheck": "npm run build:dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@grammyjs/runner": "2.0.3",
    "@narumitw/sumire-progress": "0.0.0",
    "@narumitw/sumire-url-content": "0.19.6",
    "@pydantic/logfire-node": "0.18.25",
    "grammy": "1.46.0",
    "ipaddr.js": "2.5.0",
    "taiwan-exchange-rates": "0.0.0",
    "undici": "8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
