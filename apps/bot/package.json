{
  "name": "@narumitw/sumire",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dependencies": "npm run build --workspace @narumitw/sumire-imagegen && npm run build --workspace @narumitw/sumire-policy && npm --ignore-scripts run build --workspace @narumitw/sumire-contracts && npm run build --workspace @narumitw/sumire-pi-url-reader && npm run build --workspace @narumitw/sumire-pi-polymarket && npm run build --workspace @narumitw/sumire-progress",
    "dev": "cd ../.. && node --env-file-if-exists=.env --import tsx apps/bot/src/index.ts",
    "start": "cd ../.. && node --env-file-if-exists=.env apps/bot/dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prebuild": "npm run build:dependencies",
    "predev": "npm run build:dependencies",
    "prestart": "npm run build:dependencies",
    "pretest": "npm run build:dependencies",
    "pretest:watch": "npm run build:dependencies",
    "pretypecheck": "npm run build:dependencies",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@firecrawl/anydoc": "0.2.4",
    "@grammyjs/runner": "2.0.3",
    "@narumitw/otter-cli": "0.4.0",
    "@narumitw/sumire-contracts": "0.6.1",
    "@narumitw/sumire-imagegen": "0.2.0",
    "@narumitw/sumire-pi-polymarket": "0.2.1",
    "@narumitw/sumire-pi-url-reader": "0.6.2",
    "@narumitw/sumire-policy": "0.4.1",
    "@narumitw/sumire-progress": "0.3.1",
    "@narumitw/sumire-url-reader": "0.25.2",
    "@pydantic/logfire-node": "0.18.30",
    "@simplewebauthn/server": "14.0.3",
    "grammy": "1.46.0",
    "playwright": "1.64.1",
    "taiwan-exchange-rates": "0.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
