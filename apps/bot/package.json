{
  "name": "@narumitw/sumire",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "bun run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --filter @narumitw/sumire-github-notifications build && bun run --filter @narumitw/sumire-runtime-config build && bun run --filter @narumitw/sumire-imagegen build && bun run --filter @narumitw/sumire-policy build && bun run --filter @narumitw/sumire-contracts build:compile && bun run --filter @narumitw/sumire-pi-url-reader build && bun run --filter @narumitw/sumire-pi-polymarket build && bun run --filter @narumitw/sumire-progress build",
    "dev": "cd ../.. && bun --no-env-file --env-file=.env apps/bot/src/index.ts",
    "start": "cd ../.. && bun --no-env-file --env-file=.env apps/bot/dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "prebuild": "sh -c 'bun run build:dependencies'",
    "predev": "sh -c 'bun run build:dependencies'",
    "prestart": "sh -c 'bun run build:dependencies'",
    "pretest": "sh -c 'bun run build:dependencies'",
    "pretest:watch": "sh -c 'bun run build:dependencies'",
    "pretypecheck": "sh -c 'bun run build:dependencies'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@firecrawl/anydoc": "0.2.4",
    "@grammyjs/runner": "2.0.3",
    "@narumitw/otter-cli": "0.5.0",
    "@narumitw/sumire-contracts": "0.9.0",
    "@narumitw/sumire-imagegen": "0.2.0",
    "@narumitw/sumire-pi-polymarket": "0.2.2",
    "@narumitw/sumire-pi-url-reader": "0.7.0",
    "@narumitw/sumire-policy": "0.5.0",
    "@narumitw/sumire-progress": "0.3.2",
    "@narumitw/sumire-runtime-config": "0.2.0",
    "@narumitw/sumire-url-reader": "0.26.0",
    "@pydantic/logfire-node": "0.19.2",
    "@simplewebauthn/server": "14.0.3",
    "grammy": "1.46.0",
    "playwright": "1.64.1",
    "taiwan-exchange-rates": "0.2.1",
    "zod": "4.6.7",
    "@narumitw/sumire-github-notifications": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
