{
  "name": "sumire-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "koffi@3.3.1": true,
    "protobufjs": false
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "check": "npm run check --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "if command -v husky >/dev/null 2>&1; then husky; fi",
    "precommit": "sh scripts/pre-commit.sh",
    "release": "changeset publish",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "update": "npx npm-check-updates -u -w --root"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "husky": "9.1.7"
  }
}
