{
  "name": "sumire-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "koffi@3.3.6": true,
    "onnxruntime-node": false,
    "protobufjs": false
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "node scripts/build-packages.mjs",
    "changeset": "changeset",
    "check": "npm run check --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "precommit": "prek run",
    "release": "changeset publish",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "node --test scripts/build-packages.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "update": "npx npm-check-updates -u -w --root"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "3.0.3"
  }
}
