{
  "name": "@narumitw/sumire-issues",
  "version": "0.1.0",
  "private": true,
  "description": "Private visual feedback contracts and bounded issue storage",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./analysis-store": {
      "types": "./dist/analysis-store.d.ts",
      "import": "./dist/analysis-store.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
