{
  "name": "@narumitw/sumire-pi-url-reader",
  "version": "0.7.0",
  "private": true,
  "description": "Pi URL-reading tool and skills backed by the Sumire URL reader",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/sumire.git",
    "directory": "packages/pi-url-reader"
  },
  "homepage": "https://github.com/narumiruna/sumire/tree/main/packages/pi-url-reader#readme",
  "bugs": {
    "url": "https://github.com/narumiruna/sumire/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "url"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:dependencies": "bun run --filter @narumitw/sumire-url-reader build",
    "prebuild": "sh -c 'bun run build:dependencies'",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "sh -c 'bun run build'",
    "pretypecheck": "sh -c 'bun run build:dependencies'",
    "typecheck": "tsc --noEmit",
    "pretest": "sh -c 'bun run build'",
    "test": "vitest run"
  },
  "dependencies": {
    "@narumitw/sumire-url-reader": "0.26.0",
    "ipaddr.js": "2.5.0",
    "undici": "8.12.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
