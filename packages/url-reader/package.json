{
  "name": "@narumitw/sumire-url-reader",
  "version": "0.25.2",
  "private": true,
  "description": "Source-aware URL content extraction for TypeScript and Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/sumire.git",
    "directory": "packages/url-reader"
  },
  "homepage": "https://github.com/narumiruna/sumire/tree/main/packages/url-reader#readme",
  "bugs": {
    "url": "https://github.com/narumiruna/sumire/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "sumire-url-reader": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/core/network.d.ts",
      "import": "./dist/core/network.js"
    },
    "./anydoc": {
      "types": "./dist/core/anydoc.d.ts",
      "import": "./dist/core/anydoc.js"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.2.4",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "impers": "0.1.2",
    "ipaddr.js": "2.5.0",
    "pdf-parse": "2.4.5",
    "playwright": "1.64.1",
    "turndown": "7.2.4",
    "undici": "8.12.2",
    "youtube-transcript": "1.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
