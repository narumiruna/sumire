{
  "name": "@narumitw/sumire-contracts",
  "version": "0.5.0",
  "private": true,
  "description": "Shared Sumire management API data contracts",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run build --workspace @narumitw/sumire-policy",
    "pretypecheck": "npm run build --workspace @narumitw/sumire-policy",
    "pretest": "npm run build --workspace @narumitw/sumire-policy"
  },
  "dependencies": {
    "@narumitw/sumire-policy": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
