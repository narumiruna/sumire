{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": ["/app/apps/bot/scripts/chrome-devtools.mjs"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
      }
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${FIRECRAWL_API_KEY}"
      }
    }
  }
}
