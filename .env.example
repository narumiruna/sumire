BOT_TOKEN=
# Required: comma-separated trusted Telegram user/chat IDs. Never leave empty.
# A chat ID permits anyone who can address the bot in that chat to use coding tools.
# Channel images are enabled by default; explicitly list channel IDs to authorize them.
BOT_WHITELIST=
# Optional: one explicitly allowlisted Telegram user ID for /login and admin context.
BOT_ADMIN_ID=
# Optional final URL-loading fallback and MCP credential; may incur charges.
FIRECRAWL_API_KEY=
# Required by the otter-manage-expenses skill.
OTTER_TOKEN=
# Optional redacted telemetry export.
LOGFIRE_TOKEN=
# Required for /f publication and replies over 1,000 characters.
MORSEL_API_KEY=
