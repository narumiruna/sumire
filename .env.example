BOT_TOKEN=
# Without WebUI: required comma-separated trusted Telegram user/chat IDs; never empty.
# Without WebUI, an allowed chat lets anyone who can address the bot use coding tools.
# With WebUI: initial access import only; empty denies bot access until approval.
# Channel images require an explicitly allowed channel ID.
BOT_WHITELIST=
# One Telegram user ID for administrator context and first passkey setup.
# Configure provider credentials through the administration Web UI.
BOT_ADMIN_ID=
# Optional public HTTPS admin origin, without a trailing slash. Enables the WebUI.
# BOT_WHITELIST is imported once as separate private-user and group allowlists.
ADMIN_ORIGIN=
# Send /admin in a private chat to register the first administrator passkey.
# Default backend port was checked with listenr. Bind only to loopback outside Docker.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=17465
# Optional final URL-loading fallback and MCP credential; may incur charges.
FIRECRAWL_API_KEY=
# Required by the otter-manage-expenses skill.
OTTER_TOKEN=
# Optional redacted telemetry export.
LOGFIRE_TOKEN=
# Required for /f publication and replies over 1,000 characters.
MORSEL_API_KEY=
