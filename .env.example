# Copy this file to .env and replace the required secrets.

# Required
BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Access and Telegram behavior
# Empty allows all chats and users. Otherwise use comma-separated Telegram IDs.
BOT_WHITELIST=
BOT_MAX_CONSECUTIVE_REPLIES_TO_BOTS=1
BOT_GROUP_PASSIVE_CONTEXT_ENABLED=true
BOT_IMAGE_INPUT_ENABLED=true
BOT_IMAGE_MAX_BYTES=8000000

# Agent resources and sessions
BOT_SKILLS_DIR=.agents/skills
# Empty enables every discovered skill; otherwise use comma-separated skill names.
BOT_ENABLED_SKILLS=
BOT_SOUL_PATH=SOUL.md
BOT_SOUL_REQUIRED=false
BOT_SOUL_MAX_CHARS=8000
BOT_SESSION_LOG_DIR=.telegramagent/sessions
BOT_AGENT_MAX_ATTEMPTS=3
BOT_AGENT_RETRY_BASE_DELAY_SECONDS=1
BOT_AGENT_CONTEXT_TOKEN_BUDGET=100000
BOT_AGENT_COMPACTION_TRIGGER_RATIO=0.8

# Public URL loading and kabigon fallback
BOT_PROACTIVE_ENABLED=true
BOT_PROACTIVE_URL_TIMEOUT_SECONDS=15
BOT_KABIGON_TIMEOUT_SECONDS=180
BOT_PROACTIVE_MAX_EXTRACTED_CHARS=12000
BOT_PROACTIVE_ALLOWED_SCHEMES=http,https
# Optional kabigon integrations
FIRECRAWL_API_KEY=
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# WHISPER_PATH=whisper

# Optional Morsel rich responses
MORSEL_MODE=smart
MORSEL_URL=https://morsel.narumi.dev/
MORSEL_API_KEY=
MORSEL_LONG_REPLY_THRESHOLD=2000
MORSEL_SHARE_EXPIRES_IN_SECONDS=2592000
MORSEL_TELEGRAM_INSTANT_VIEW=true
TELEGRAM_INSTANT_VIEW_RHASH=
MORSEL_TIMEOUT_SECONDS=12

# Optional when running outside the repository layout.
# TELEGRAMAGENT_PROJECT_ROOT=/absolute/path/to/repository
