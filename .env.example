BOT_TOKEN=
# Configure the shared OpenAI account through Telegram /login and chat models through /model.
# Required to start the bot: comma-separated trusted Telegram user/chat IDs. Never leave empty.
# A chat ID permits anyone who can address the bot in that chat to use Pi's coding tools.
# For channel images, list the channel chat ID explicitly; user IDs never authorize a channel.
BOT_WHITELIST=
# Optional Pi tool working directory; local default is the repository root.
# The Docker image sets this to /workdir, which is backed by the workdir volume.
# BOT_WORKDIR=/workdir
# Optional: one Telegram user ID (not a chat ID); use /id to find yours.
# Explicitly allowlist this ID to enable /login; required for first login without Pi credentials.
# Also identifies the admin in Telegram/Pi context; does not grant or restrict tool access.
BOT_ADMIN_ID=
# Opt-in Pi JavaScript tool orchestration; existing whitelist and coding-tool permissions apply.
BOT_CODEMODE_ENABLED=false
# Per-script host deadline (0.1–3600 seconds), including nested tools; not the entire model turn.
BOT_CODEMODE_TIMEOUT_SECONDS=300
BOT_DOCUMENT_INPUT_ENABLED=true
BOT_DOCUMENT_MAX_BYTES=20000000
BOT_DOCUMENT_MAX_MARKDOWN_CHARS=50000
BOT_DOCUMENT_CONVERSION_TIMEOUT_SECONDS=30
# Shared document slots across chats, held from before download until conversion exits.
BOT_DOCUMENT_MAX_CONCURRENT_CONVERSIONS=2
BOT_REPLY_TREE_ENABLED=true
BOT_REPLY_TREE_MAX_RECORDS_PER_CHAT=1000
BOT_REPLY_TREE_MAX_INDEX_BYTES=1000000
# Built-in/DNS phase limit; the total URL budget also includes this phase.
BOT_URL_TIMEOUT_SECONDS=15
# Total tool deadline and shared /f source deadline (no hidden 30-second cap).
BOT_URL_CONTENT_TIMEOUT_SECONDS=180
BOT_URL_MAX_EXTRACTED_CHARS=12000
BOT_URL_ALLOWED_SCHEMES=http,https
BOT_IMAGE_INPUT_ENABLED=true
# Opt-in: index new images in allowlisted channels for on-demand Pi read_image calls.
# Channel posts never invoke Pi or send messages. Requires BOT_IMAGE_INPUT_ENABLED=true.
BOT_CHANNEL_IMAGE_INPUT_ENABLED=false
BOT_IMAGE_MAX_BYTES=8000000
# Local Whisper CLI is required for Telegram voice/audio input; files are never sent to a hosted transcription API.
BOT_AUDIO_INPUT_ENABLED=true
BOT_AUDIO_MAX_BYTES=20000000
BOT_AUDIO_MAX_DURATION_SECONDS=600
BOT_AUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=180
BOT_AUDIO_MAX_TRANSCRIPT_CHARS=12000
# Enables the final generic Firecrawl fallback after local URL loaders fail.
# Sends the target URL, including its query, to Firecrawl and may incur charges.
FIRECRAWL_API_KEY=
# Required by the otter-manage-expenses skill. Keep this value in the ignored .env only.
OTTER_TOKEN=
LOGFIRE_TOKEN=
MORSEL_URL=https://morsel.narumi.dev/
# Required for /f article publication and messages over 1000 characters; failures never expose generated content inline.
MORSEL_API_KEY=
