BOT_TOKEN=
# Required Telegram user ID for administrator context and first passkey setup.
# New databases deny all chats until approval through /allow and the WebUI.
# Configure channel access explicitly on the WebUI Access page.
# Configure provider credentials through the administration Web UI.
BOT_ADMIN_ID=
# The WebUI defaults to http://localhost:17465; it cannot be disabled.
# Optional public HTTPS admin origin, without a trailing slash, for remote access.
ADMIN_ORIGIN=
# Send /admin in a private chat to register the first administrator passkey.
# Send /allow in a target private chat or group for a 15-minute administrator approval link.
# Open the default local URL on the computer that runs Sumire, not inside Telegram.
# Default backend port was checked with listenr. Bind only to loopback outside Docker.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=17465
# 32-byte encryption key as 64 hex characters: openssl rand -hex 32.
# Configure on the trusted host only; existing canonical Base64 keys remain supported.
# Back up separately from admin.sqlite. Missing/wrong key locks secrets, not the Web UI.
ENCRYPTION_KEY=
# Legacy one-time import source only. Manage this key in Secrets & variables after import.
# Firecrawl URL loading and MCP use the stored key and may incur charges.
FIRECRAWL_API_KEY=
# Required by the otter-manage-expenses skill.
OTTER_TOKEN=
# Optional redacted telemetry export.
LOGFIRE_TOKEN=
# Legacy one-time import source only. Manage MORSEL_API_KEY through the Web UI.
# Required for /f publication and replies over 1,000 characters.
MORSEL_API_KEY=
